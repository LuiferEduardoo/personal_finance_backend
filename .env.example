# App
NODE_ENV=development
PORT=3001
# orígenes permitidos por CORS, separados por comas ("*" permite todos)
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=personal_finance
# esquema. Por defecto public. En BD gestionadas como Filess.io NO hay public:
# el esquema es el NOMBRE de tu base de datos → pon aquí el mismo valor de DB_NAME.
DB_SCHEMA=public

# Auth
JWT_SECRET=change-me
# duración del access token (CLAUDE.md: 20 minutos)
JWT_ACCESS_EXPIRATION=20m
# duración del refresh token en días (CLAUDE.md: 6 meses)
REFRESH_TOKEN_TTL_DAYS=180
AUTH_ENCRYPTION_KEY=

# Correo transaccional (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kairos

# Límites por proceso. En despliegues con varias réplicas usa un proxy/Redis.
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_ATTEMPTS=5

# OpenAI (análisis de facturas por imagen/texto con GPT-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# TypeSafe (Jev): clasifica gastos y artículos en las categorías del usuario
# (facturas por foto/texto y facturas de Gmail). Opcional: sin clave no se
# sugieren categorías y todo lo demás funciona igual.
TYPESAFE_API_KEY=
# modelo fijado para que las probabilidades (y los umbrales) no cambien solos
TYPESAFE_MODEL=jev-1.14.0

# Twelve Data (precios de mercado e histórico para inversiones).
# Todavía no se consume: el motor de precios llega en la siguiente fase.
# Plan Basic gratuito: 8 créditos/minuto, 800/día. Esos límites se leen de aquí
# para poder subir de plan sin tocar código.
TWELVEDATA_API_KEY=
TWELVEDATA_CREDITS_PER_MINUTE=8
TWELVEDATA_CREDITS_PER_DAY=800

# Cifrado de las credenciales de bróker (AES-256-GCM).
# EXACTAMENTE 64 caracteres hexadecimales. Genérala con:  openssl rand -hex 32
#
# AVISO: XTB no tiene API oficial y su vía no oficial se autentica con el
# usuario y la CONTRASEÑA REALES de trading, no con una API key revocable.
# Un volcado de esta base de datos MÁS una fuga de esta clave equivale a
# comprometer la cuenta de trading entera. Empieza con credenciales DEMO.
# Si pierdes esta clave, las credenciales guardadas son irrecuperables.
INVESTMENTS_ENCRYPTION_KEY=
# Clave anterior durante una rotación: deja aquí la vieja, pon la nueva arriba
# y ejecuta la mutación rotateBrokerCredentials.
INVESTMENTS_ENCRYPTION_KEY_PREVIOUS=

# Lectura de facturas electrónicas desde Gmail (solo lectura, gmail.readonly).
# Cliente OAuth "Aplicación web" de Google Cloud. La URI de redirección debe
# apuntar a este backend: https://<host>/mail/google/callback
# OJO: con la app OAuth en estado "Testing" Google caduca el refresh token a
# los 7 días. Pásala a "In production" (sin verificar sirve para uso personal).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAIL_REDIRECT_URI=http://localhost:3001/mail/google/callback
# a dónde vuelve el navegador tras conectar (se añade /settings/mail?status=...)
FRONTEND_URL=http://localhost:5173
# Push (opcional). Sin él los correos nuevos llegan con el job horario.
# Topic de Pub/Sub con permiso de publicación para gmail-api-push@system.gserviceaccount.com
GMAIL_PUBSUB_TOPIC=projects/<proyecto>/topics/<topic>
# La suscripción push debe usar autenticación OIDC con esta audiencia y esta
# cuenta de servicio; el webhook rechaza cualquier otra cosa.
GMAIL_PUSH_AUDIENCE=https://<host>/mail/gmail/push
GMAIL_PUSH_SERVICE_ACCOUNT=
# Cifrado del refresh token de Gmail (AES-256-GCM), independiente del de
# inversiones. EXACTAMENTE 64 hex:  openssl rand -hex 32
MAIL_ENCRYPTION_KEY=
MAIL_ENCRYPTION_KEY_PREVIOUS=

# pgAdmin (docker-compose.dev.yml)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
